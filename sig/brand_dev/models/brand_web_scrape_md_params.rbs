      attr_reader use_main_content_only: bool?

      def use_main_content_only=: (bool) -> bool

      attr_reader wait_for_ms: Integer?

      def wait_for_ms=: (Integer) -> Integer

      def initialize: (
        url: String,
        ?exclude_selectors: ::Array[String],
        ?headers: ::Hash[Symbol, String],
        ?include_frames: bool,
        ?include_images: bool,
        ?include_links: bool,
